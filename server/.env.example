PORT=8080
JWTPRIVATEKEY=your_jwt_secret_key
SALT=10

# Redis — on Railway, set this to the Redis plugin's ${{Redis.REDIS_URL}}
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini API key (required for chatbot)
GEMINI_API_KEY=your_gemini_api_key

# Ollama (optional local LLM — omit on Railway unless you run your own Ollama service)
# OLLAMA_HOST=http://127.0.0.1:11434

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name
